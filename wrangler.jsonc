{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whip-worker",
  "main": "worker/main.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "broad.takehomo.com",
      "custom_domain": true,
    },
  ],
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  "secrets": {
    "required": [
      "AUTHORIZED_GUILD_ID",
      "CALLS_APP_ID",
      "CALLS_APP_SECRET",
      "DISCORD_CLIENT_ID",
      "DISCORD_CLIENT_SECRET",
      "JWT_SECRET",
      "LIVE_TOKEN_PEPPER",
      "NOTIFICATIONS_DISCORD_WEBHOOK_URL",
      "TURN_KEY_API_TOKEN",
      "TURN_KEY_ID",
    ],
  },
  // "vars": {
  //   "AUTHORIZED_GUILD_ID": "your-discord-guild-id-here",
  //   "ENVIRONMENT": "development"
  // },
  "vars": {
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "info",
  },
  // Live broadcasts, publisher tokens, users, and the alarm that ends a
  // broadcast once its OBS reconnect grace period passes. See
  // worker/live-state.ts.
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_STATE",
        "class_name": "LiveState",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveState"],
    },
  ],
  "assets": {
    "not_found_handling": "none",
    "run_worker_first": false,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
