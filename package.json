{
  "name": "wish-broad",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "dev:full": "wrangler dev",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false --strict-vars=false",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "check": "tsc -b && oxlint --deny-warnings && pnpm check:unused-exports",
    "check:unused-exports": "knip --exports --no-progress",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "schema:check": "node scripts/check-schema-from-migrations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:react": "react-doctor --yes --json --no-telemetry"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@playwright/cli": "^0.1.22",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-better-tailwindcss": "^4.8.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.17",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "neverthrow": "^8.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "valibot": "^1.5.0"
  }
}
