{
  "name": "wish-broad",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": "26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "dev:full": "wrangler dev",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false --strict-vars=false",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && eslint && pnpm check:unused-exports",
    "check:unused-exports": "knip --exports --no-progress",
    "schema:check": "node scripts/check-schema-from-migrations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:react": "react-doctor --yes --json --no-telemetry"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@cloudflare/workers-types": "^4.20260612.1",
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.14",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "eslint-plugin-unicorn": "^67.0.0",
    "globals": "^17.6.0",
    "knip": "^6.17.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-doctor": "^0.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "hono": "^4.12.25",
    "neverthrow": "^8.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swr": "^2.4.1",
    "valibot": "^1.4.1"
  }
}
