{
  "name": "wish-broad",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "26"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "dev:full": "wrangler dev",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime false --strict-vars=false",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && oxlint --deny-warnings && pnpm check:unused-exports",
    "check:unused-exports": "knip --exports --no-progress",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "schema:check": "node scripts/check-schema-from-migrations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:react": "react-doctor --yes --json --no-telemetry"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@playwright/cli": "^0.1.18",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "knip": "^6.32.2",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "^0.9.12",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "neverthrow": "^8.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "valibot": "^1.4.2"
  }
}
