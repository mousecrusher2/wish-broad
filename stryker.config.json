{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "cleanTempDir": "always",
  "clearTextReporter": {
    "allowColor": false,
    "logTests": false,
    "reportMutants": false,
    "reportTests": false,
    "skipFull": true
  },
  "concurrency": 4,
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "worker/**/*.ts",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!worker/types.ts"
  ],
  "reporters": ["clear-text", "html", "json"],
  "tempDirName": "stryker-tmp",
  "testRunner": "vitest",
  "thresholds": {
    "break": 95,
    "high": 95,
    "low": 95
  },
  "tsconfigFile": ".stryker-no-tsconfig.json",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  }
}
